{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zero OS",
  "version": "0.6.0",
  "identifier": "com.cyph.zero-os",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:8000 http://localhost:5173; connect-src 'self' http://localhost:8000 http://localhost:5173 ws://localhost:5173; media-src 'self' blob: data:; img-src 'self' data: blob:;"
    },
    "windows": [
      {
        "title": "Zero OS",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "fullscreen": false,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "alwaysOnTop": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
