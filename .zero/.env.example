# Copy this file to .env and fill in your keys
ANTHROPIC_API_KEY=
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
PORCUPINE_ACCESS_KEY=
ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa

# --- Self-fixing loop (core/quality.py) ---
# Build->Grade->Fix quality gate on every answer. On by default.
ZERO_SELF_FIX=1
ZERO_SELF_FIX_MAX_ITERS=2

# --- AirLLM optional local deep brain (core/llm.py) ---
# Run a 70B-class model locally on the 6GB GPU. SLOW + disk-heavy. Opt-in only.
# pip install airllm  then set:
AIRLLM_ENABLED=0
AIRLLM_MODEL=garage-bAInd/Platypus2-70B-instruct
AIRLLM_COMPRESSION=4bit
AIRLLM_MAX_INPUT=512
