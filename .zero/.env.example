# Copy this file to .env and fill in your keys.
# .env is gitignored — never commit real keys.

# --- LLM providers (core/llm.py) ---
# Chain: moonshot -> deepseek -> groq -> ollama. The first one with a key wins,
# and any failure transparently falls through to the next, so Zero never goes dark.
# See docs/model_setup.md for how to get a Kimi key and what it costs.
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
# ANTHROPIC_API_KEY=        # leave commented unless the account has credit —
#                           # a dead key costs a failed round-trip on EVERY call

# Optional Moonshot model overrides. Set MOONSHOT_DEEP_MODEL=kimi-k2.6 to avoid
# ever paying k3 rates ($3/$15 per 1M vs $0.95/$4.00).
# MOONSHOT_MODEL=kimi-k2.6
# MOONSHOT_DEEP_MODEL=kimi-k3

# Hard ceiling on any single cloud LLM call, seconds.
LLM_TIMEOUT_S=90

# --- Hybrid local routing (free, needs Ollama running) ---
# Serves the 'fast' tier (agent routing, query decomposition, draft grading —
# the many cheap calls) from your GPU instead of the cloud. Falls back to cloud
# automatically if Ollama isn't up. qwen3.5:4b is 3.4GB so Whisper still fits
# in the 6GB alongside it; an 8B model would not.
ZERO_LOCAL_FAST=0
OLLAMA_MODEL=qwen3.5:4b

# --- Telegram bot (phone/telegram_bot.py) — Zero's main interface ---
# See docs/telegram_setup.md. BOTH values are required: Zero refuses to start an
# unlocked bot because it can delete files and run shell commands.
# Token from @BotFather, numeric id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_VOICE_REPLIES=0

# --- Search + voice ---
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa
PORCUPINE_ACCESS_KEY=

# --- Phone bridge (phone/bridge.py) ---
PHONE_API_KEY=

# --- Self-fixing loop (core/quality.py) ---
# Build->Grade->Fix quality gate on every answer. On by default.
# Set ZERO_SELF_FIX=0 or ITERS=1 if you want faster, rougher replies.
ZERO_SELF_FIX=1
ZERO_SELF_FIX_MAX_ITERS=2

# --- Sandboxed agent execution (sandbox/) ---
ZERO_SANDBOX_AGENTS=false

# --- Wake word debugging (voice/wake.py) ---
# WAKE_DEBUG=1 logs the best confidence score once a second so misses are visible.
WAKE_DEBUG=0

# --- AirLLM optional local deep brain (core/llm.py) ---
# Run a 70B-class model locally on the 6GB GPU. SLOW + disk-heavy. Opt-in only.
# pip install airllm  then set:
AIRLLM_ENABLED=0
AIRLLM_MODEL=garage-bAInd/Platypus2-70B-instruct
AIRLLM_COMPRESSION=4bit
AIRLLM_MAX_INPUT=512

# Folders Zero reads and remembers (notes + PDFs), semicolon-separated
ZERO_KNOWLEDGE_DIRS=
